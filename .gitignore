__pycache__/
*.py[cod]
*.log
.venv/
venv/
.env
.env.*

# Local credentials must never be committed
credentials/
bili_cookie.txt
obs_config.txt
uid.txt
*.cookie
*.secret
*.key
chrome_profile/

# Legacy local secrets and standalone-bot configuration
room_config.txt
house.txt

# Preserve model directory placeholders while keeping local model assets out of version control
!models/.gitkeep
!models/moc2/**/.gitkeep
!models/moc3/.gitkeep

# Local runtime configuration (default templates remain tracked)
config/local/

# LOL Hex 本机运行数据：不提交截图、OCR/状态缓存和运行期生成文件
extensions/lol_hex_display/data/
extensions/lol_hex_display/screenshots/
extensions/lol_hex_display/logs/

# Unified runtime data and logs (keep documentation tracked)
logs/
data/*
!data/README.md
data/music/
data/video/
data/cache/
*.tmp

# Retired migration markers/journals may remain on user machines; keep them ignored.
# The current runtime never reads, writes, or deletes these historical marker files.
config.json
user_settings.json
config/.legacy_config_migrated_v1.json
config/.legacy_config_migration_v1.json

# PyInstaller build output
build/
dist/
*.spec
